# Chunk size in words for ingestion and retrieval experiments.
CHUNK_SIZE_WORDS=120

# Overlap in words between neighboring chunks.
CHUNK_OVERLAP_WORDS=30

# Active storage backend for processed chunks and retrieval data.
CHUNK_STORAGE_BACKEND=file

# Base PostgreSQL connection settings for the future pgvector backend.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable

# Optional full database URL for the pgvector backend.
PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_knowledge_assistant?sslmode=disable

# Future pgvector storage settings.
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=document_chunks
PGVECTOR_EMBEDDING_DIM=384

# Enable or disable optional LLM-backed answer generation.
LLM_ENABLED=false

# API key for an OpenAI-compatible provider.
LLM_API_KEY=your_api_key_here

# Base URL for the provider API.
LLM_API_BASE=https://api.openai.com/v1

# Chat model name used for grounded answer generation.
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds for the LLM HTTP call.
LLM_TIMEOUT_SEC=20

# Upper limit for response length from the LLM.
LLM_MAX_TOKENS=220

# Enable or disable external web search via SerpAPI.
SERPAPI_ENABLED=false

# API key for SerpAPI web search.
SERPAPI_API_KEY=your_serpapi_key_here

# Search engine name used by SerpAPI.
SERPAPI_ENGINE=google

# Default number of external search results to request.
SERPAPI_NUM_RESULTS=5

# Request timeout in seconds for SerpAPI.
SERPAPI_TIMEOUT_SEC=15

# Admin access for documents, system controls, upload, reindex, and other protected actions.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change_me_admin_password

# Session secret for admin auth cookies. Change this before public deployment.
ADMIN_SESSION_SECRET=change_me_session_secret
