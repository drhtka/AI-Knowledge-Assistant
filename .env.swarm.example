# Image and routing
APP_IMAGE=ai-knowledge-assistant:local
APP_PORT=8000

# App runtime
CHUNK_STORAGE_BACKEND=pgvector
UVICORN_WORKERS=1
DB_STARTUP_TIMEOUT_SEC=90

# App scaling and resources
APP_REPLICAS=1
APP_CPU_RESERVATION=0.25
APP_CPU_LIMIT=1.00
APP_MEMORY_RESERVATION=256M
APP_MEMORY_LIMIT=1G

# Database image, scaling and resources
DB_IMAGE=pgvector/pgvector:pg16
DB_REPLICAS=1
DB_CPU_RESERVATION=0.25
DB_CPU_LIMIT=1.00
DB_MEMORY_RESERVATION=256M
DB_MEMORY_LIMIT=1G

# Database connection
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ai_knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_SSL_MODE=disable
POSTGRES_PASSWORD_SECRET=ai_knowledge_assistant_postgres_password

# pgvector and storage tables
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=document_chunks
PGVECTOR_EMBEDDING_DIM=384
POSTGRES_RUNTIME_STATE_TABLE=runtime_state
POSTGRES_REINDEX_HISTORY_TABLE=reindex_history
POSTGRES_RETRIEVAL_HISTORY_TABLE=retrieval_history
POSTGRES_WEB_SEARCH_HISTORY_TABLE=web_search_history

# Chunking
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=30

# Optional LLM integration
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=20
LLM_MAX_TOKENS=220

# Optional SerpAPI integration
SERPAPI_ENABLED=false
SERPAPI_ENGINE=google
SERPAPI_NUM_RESULTS=5
SERPAPI_TIMEOUT_SEC=15
